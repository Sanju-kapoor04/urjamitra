# =================================================================
# UrjaMitra Environment Configuration Template (.env.example)
# Product: UrjaMitra (urjamitra)
# Tagline: Your Smart Utility Companion.
# NOTE: Copy this file to .env and fill in real production values.
# NEVER commit .env to version control.
# =================================================================

# ----------------- BACKEND CONFIGURATION -----------------
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random 32+ character string)
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars

# AI Microservice URL (FastAPI Python Service)
# For local development: http://127.0.0.1:8001
# For Docker Compose: http://ai-service:8001
# For Render / Railway / Cloud: https://your-urjamitra-ai-service.onrender.com
AI_SERVICE_URL=http://127.0.0.1:8001

# MongoDB Connection String (Optional: falls back to embedded SQLite if empty)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/urjamitra?retryWrites=true&w=majority
MONGODB_URI=

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# ----------------- AI / LLM SERVICE CONFIGURATION -----------------
AI_PORT=8001

# LLM Provider API Keys (Optional: operates deterministic rules if empty)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ----------------- FRONTEND CONFIGURATION -----------------
# Base API URL for production frontend builds (Vite)
# Leave blank when using same-origin or reverse-proxy
VITE_API_BASE_URL=
